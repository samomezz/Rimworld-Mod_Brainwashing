  <ThingDef ParentName="BuildingBase">
    <defName>PropagandaSpeaker</defName>
    <label>propaganda speaker</label>
    <description>State-funded lies</description>
	<thingClass>Brainwashing.Building_PropagandaSpeaker</thingClass>
    <minifiedDef>MinifiedThing</minifiedDef>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <graphicClass>Graphic_Multi</graphicClass>
      <texPath>Things/Building/Misc/Loudspeaker/Loudspeaker</texPath>
      <drawSize>(1,1)</drawSize>
      <shadowData>
        <volume>(0.5, 1, 0.5)</volume>
      </shadowData>
    </graphicData>
    <thingCategories>
      <li>BuildingsMisc</li>
    </thingCategories>
    <designationCategory>Ideology</designationCategory>
    <rotatable>false</rotatable>
    <receivesSignals>true</receivesSignals>
    <fillPercent>0.35</fillPercent>
    <selectable>true</selectable>
    <useHitPoints>true</useHitPoints>
    <tickerType>Rare</tickerType>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <size>(1,1)</size>
    <statBases>
      <MaxHitPoints>25</MaxHitPoints>
      <WorkToBuild>1500</WorkToBuild>
      <Mass>5</Mass>
    </statBases>
    <researchPrerequisites>
      <li>BrainwashingDevices</li>
	  <li>Electricity</li>
    </researchPrerequisites>
    <costList>
      <Steel>30</Steel>
      <ComponentIndustrial>1</ComponentIndustrial>
    </costList>
    <comps>
     <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>30</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable"/>
    </comps>
  </ThingDef>
  <ThoughtDef>
    <defName>SwayedByPropaganda</defName>
    <thoughtClass>Thought_MemoryObservation</thoughtClass>
    <durationDays>1</durationDays>
    <stackLimit>5</stackLimit>
    <stages>
      <li>
        <label>was swayed by propaganda</label>
        <description>It's good to hear the truth.</description>
        <baseMoodEffect>3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
    <ThoughtDef>
    <defName>HeardPropaganda</defName>
    <thoughtClass>Thought_MemoryObservation</thoughtClass>
    <durationDays>1</durationDays>
    <stackLimit>5</stackLimit>
    <stages>
      <li>
        <label>subjected to propaganda</label>
        <description>Trying to avoid it</description>
        <baseMoodEffect>-3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  <TraitDef>
    <defName>PropagandaResistant</defName>
    <degreeDatas>
      <li>
        <label>propaganda resistant</label>
        <description>{PAWN_nameDef} knows propaganda when {PAWN_pronoun} sees it. Proportional to {PAWN_possessive} Intellectual skill (up to level 16), propaganda has less influence on {PAWN_objective}, but {PAWN_pronoun} will receive a mood penalty from it.</description>
        <skillGains>
          <Intellectual>2</Intellectual>
		  <Social>3</Social>
        </skillGains>
      </li>
    </degreeDatas>
    <conflictingTraits>
    </conflictingTraits>
    <requiredWorkTags>
      <li>Social</li>
    </requiredWorkTags>
  </TraitDef>
  <RitualPatternDef>
    <defName>HoldMass_Pattern</defName>
    <ritualBehavior>HoldMass_Behaviour</ritualBehavior>
    <ritualTargetFilter>AltarOrRitualSpot</ritualTargetFilter>
    <ritualObligationTargetFilter>RitualSpotOrAltar</ritualObligationTargetFilter>
    <ritualExplanation>In case of success, their certainty will be reduced or they will convert immediately. If it backfires, their certainty in own beliefs will increase.</ritualExplanation>
    <ritualOutcomeEffect>HoldMass_Outcome</ritualOutcomeEffect>
    <alwaysStartAnytime>true</alwaysStartAnytime>
    <canMergeGizmosFromDifferentIdeos>false</canMergeGizmosFromDifferentIdeos>
  </RitualPatternDef>
  <RitualBehaviorDef>
    <defName>HoldMass_Behaviour</defName>
	<workerClass>Brainwashing.RitualBehaviorWorker_HoldMass</workerClass>
    <durationTicks>4500</durationTicks>
    <spectatorsLabel>Participants</spectatorsLabel>
    <spectatorGerund>participate</spectatorGerund>
    <roles Inherit="False">
      <li Class="RitualRoleTag">
        <label>speaker</label>
        <id>moralist</id>
        <tag>Moralist</tag>
        <precept>IdeoRole_Moralist</precept>
        <required>True</required>
        <maxCount>1</maxCount>
        <countsAsParticipant>False</countsAsParticipant>
        <allowChild>false</allowChild>
      </li>
    </roles>
    <stages>
      <li>
        <defaultDuty>Spectate</defaultDuty>
        <endTriggers>
          <li Class="StageEndTrigger_RolesArrived">
            <roleIds>
              <li>moralist</li>
            </roleIds>
          </li>
        </endTriggers>
        <roleBehaviors>
          <li>
            <roleId>moralist</roleId>
            <dutyDef>ArriveToCell</dutyDef>
            <customPositions>
              <li Class="RitualPosition_BehindThingCenter" />
            </customPositions>
          </li>
        </roleBehaviors>
      </li>
      <li>
        <defaultDuty>Spectate</defaultDuty>
        <endTriggers>
          <li Class="StageEndTrigger_DurationPercentage">
            <percentage>1</percentage>
          </li>
        </endTriggers>
	  <roleBehaviors>
          <li>
            <roleId>moralist</roleId>
            <dutyDef>SpeakOnCellFacingSpectators</dutyDef>
            <speakerInteraction>Speech_Conversion</speakerInteraction>
            <customPositions>
              <li Class="RitualPosition_Lectern">
                <maxDistanceToFocus>5</maxDistanceToFocus>
              </li>
              <li Class="RitualPosition_OnInteractionCell" />
            </customPositions>
          </li>
        </roleBehaviors>
		</li>
    </stages>
  </RitualBehaviorDef>
  <RitualOutcomeEffectDef>
    <defName>HoldMass_Outcome</defName>
    <description>If it goes well, everyone will gain some certainty towards the moralist's ideology. If it goes poorly, everyone may lose some certainty.</description>
    <workerClass>Brainwashing.RitualOutcomeEffectWorker_HoldMass</workerClass>
    <comps>
      <li Class="RitualOutcomeComp_RoomStat">
        <label>room impressiveness</label>
        <statDef>Impressiveness</statDef>
        <curve>
          <points>
            <li>0,  0</li>
            <li>50,  0.1</li>
            <li>120, 0.2</li>
          </points>
        </curve>
      </li>
      <li Class="RitualOutcomeComp_ParticipantCount">
        <label>participant count</label>
        <curve>
          <points>
            <li>(1,  0.0)</li>
            <li>(5,  0.3)</li>
            <li>(10, 0.4)</li>
          </points>
        </curve>
      </li>
      <li Class="RitualOutcomeComp_PawnStatScaled">
        <label>{PAWN_labelShort}'s social impact</label>
        <labelAbstract>speaker's social impact</labelAbstract>
        <roleId>moralist</roleId>
        <statDef>SocialImpact</statDef>
        <curve>
          <points>
            <li>(0.2,  0.0)</li>
            <li>(0.6,  0.18)</li>
            <li>(1.0, 0.25)</li>
            <li>(1.5, 0.3)</li>
          </points>
        </curve>
      </li>
    </comps>
    <outcomeChances>
      <li>
        <label>Dreadful</label>
        <chance>0.02</chance>
		<memory>DreadfulMass</memory>
        <ideoCertaintyOffset>-0.2</ideoCertaintyOffset>
        <description>The {0} was dreadful! The speaker must have made that all up. We all left feeling disillusioned. Each attending colonist lost between 10 and 30 certainty points.</description>
        <positivityIndex>-2</positivityIndex>
      </li>
      <li>
        <label>Weird</label>
        <chance>0.25</chance>
		<memory>WeirdMass</memory>
        <ideoCertaintyOffset>0</ideoCertaintyOffset>
        <description>The {0} was weird. Most of the arguments were unclear, and the speech included a rambling tangent about the speaker's childhood trauma? Why? We should have stayed in bed today. Nobody will remember this.</description>
        <positivityIndex>-1</positivityIndex>
      </li>
      <li>
        <label>Great</label>
        <chance>0.725</chance>
        <ideoCertaintyOffset>0.4</ideoCertaintyOffset>
        <memory>GreatMass</memory>
        <description>The {0} was Great. The {0} allowed us to remember fundamental and transcendental things about ourselves that we didn't know we had forgotten. Each attending colonist gained between 30 and 50 certainty points.</description>
        <positivityIndex>1</positivityIndex>
      </li>
      <li>
        <label>Masterful</label>
        <chance>0.005</chance>
        <ideoCertaintyOffset>0.9</ideoCertaintyOffset>
        <memory>MasterfulMass</memory>
        <description>The {0} was masterful! It was a core memory and a bonding experience for all. You just had to be there. Truly a great moment for our colony. Each attending colonist gained between 80 and 100 certainty points.</description>
        <positivityIndex>2</positivityIndex>
      </li>
    </outcomeChances>
  </RitualOutcomeEffectDef>
  <PreceptDef>
    <defName>HoldMass_Precept</defName>
    <label>Mass</label>
    <description>Reassure/convert everyone.</description>
    <issue>Ritual</issue>
    <preceptClass>Precept_Ritual</preceptClass>
    <visible>false</visible>
    <countsTowardsPreceptLimit>false</countsTowardsPreceptLimit>
    <selectionWeight>1.0</selectionWeight>
    <ritualPatternBase>HoldMass_Pattern</ritualPatternBase>
    <iconPath>UI/Abilities/ConversionRitual</iconPath>
    <useCooldownFromAbilityGroupDef>Moralist</useCooldownFromAbilityGroupDef>
    <sourcePawnRoleDef>IdeoRole_Moralist</sourcePawnRoleDef>
    <sourceAbilityDef>HoldMass_Ability</sourceAbilityDef>
    <classicExtra>true</classicExtra>
  </PreceptDef>
  <AbilityDef ParentName="SpeechBase">
    <defName>HoldMass_Ability</defName>
    <label>hold mass</label>
    <description>Hold a mass to bring people together under your shared beliefs. If it goes well, everyone will gain some certainty towards the moralist's ideology. If it goes poorly, everyone may lose some certainty. \n\nTo start this ritual at a specific place, select a ritual spot or matching altar/ideogram.</description>
    <iconPath>UI/Abilities/ConversionRitual</iconPath>
    <groupDef>Moralist</groupDef>
    <overrideGroupCooldown>True</overrideGroupCooldown>
    <cooldownTicksRange>480000</cooldownTicksRange>
    <targetRequired>False</targetRequired>
    <gizmoClass>Command_Ability</gizmoClass>
    <comps>
      <li Class="CompProperties_AbilityStartConversion">
        <ritualDef>HoldMass_Precept</ritualDef>
      </li>
    </comps>
  </AbilityDef>
  <ThoughtDef>
    <defName>MasterfulMass</defName>
    <thoughtClass>Thought_AttendedRitual</thoughtClass>
    <durationDays>6</durationDays>
